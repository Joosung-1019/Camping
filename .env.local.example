# 공공데이터포털 - 한국관광공사_고캠핑정보 조회서비스 (일반 인증키, Decoding 값 그대로 사용)
GOCAMPING_SERVICE_KEY=

# OpenWeatherMap API Key
OPENWEATHER_API_KEY=

# 카카오 디벨로퍼스 JavaScript 키 (클라이언트에 노출되는 값)
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# Tmap(SK Open API) appKey - 자동차 이동시간 계산용
TMAP_APP_KEY=

# Vercel Storage(Redis) 연결 문자열 - 방문 기록/평점 저장용
REDIS_URL=

# 카카오 REST API 키 (주소 -> 좌표 변환용, 카카오 디벨로퍼스 플랫폼 키 페이지)
KAKAO_REST_API_KEY=
